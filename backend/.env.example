# DarkAI Backend Environment Variables
# Copy this file to .env and fill in values

# ─── Application ───────────────────────────────────────────
APP_NAME=DarkAI
APP_ENV=development
DEBUG=true
API_VERSION=v1

# ─── Security ──────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_OF_AT_LEAST_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ──────────────────────────────────────────────
# SQLite (development default)
DATABASE_URL=sqlite:///./darkai.db

# PostgreSQL (production - uncomment and fill)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/darkai_db

# ─── MFA / TOTP ────────────────────────────────────────────
MFA_ISSUER=DarkAI-Security

# ─── File Upload ───────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,bmp,webp
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,ogg,flac
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,mkv

# ─── Risk Thresholds ───────────────────────────────────────
RISK_LOW_MAX=29
RISK_MEDIUM_MAX=59
RISK_HIGH_MAX=79
# CRITICAL = 80-100

# ─── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Reports ───────────────────────────────────────────────
REPORTS_DIR=reports

# ─── Models ────────────────────────────────────────────────
MODELS_DIR=../models
